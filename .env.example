# Copier ce fichier en .env et remplir les valeurs AVANT de lancer docker compose
# Le fichier .env n'est jamais commité (voir .gitignore)
# ATTENTION : ne jamais commiter .env sur GitHub

# Interface réseau de capture (vérifier avec: ip a)
# Exemples : eth0, ens18, enp6s18
IFACE=ens18

# IP du serveur à surveiller spécifiquement (règles Snort 1000013-1000016)
SNORT_MONITORED_SERVER=x.x.x.x

# Mot de passe admin Grafana (défaut: changeme — à changer impérativement)
GRAFANA_ADMIN_PASSWORD=changeme_remplacer
N8N_PASSWORD=changeme_remplacer

# Webhook Slack pour les alertes Grafana (optionnel)
# Obtenir sur : https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# AutoBlock — réponse automatique iptables
# DRY_RUN=true = simule les blocs sans appliquer iptables (recommande pour commencer)
# DRY_RUN=false = blocs reels via iptables (necessite de tester d'abord en dry-run)
AUTOBLOCK_DRY_RUN=true
BLOCK_DURATION_MIN=60
# IPs a ne JAMAIS bloquer (gateway, DNS internes, serveurs critiques) — separees par virgule
AUTOBLOCK_ALLOWLIST=192.168.1.1,192.168.1.254
# Secret partagé pour authentifier les appels au webhook AutoBlock (block/unblock/alert).
# OBLIGATOIRE en mode LIVE (DRY_RUN=false) — sinon les blocages sont refusés (fail-safe).
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
# Côté Grafana, ajouter le token dans l'URL du contact point : .../webhook/alert?token=VOTRE_SECRET
AUTOBLOCK_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
# Services d'observabilité complémentaires (Blackbox, Kibana, ntopng, Arkime, NetBox)
# Tous liés à localhost. Générer les secrets :
#   python3 -c "import secrets; print(secrets.token_hex(32))"   → ARKIME_PASSWORD_SECRET, NETBOX_SECRET_KEY, NETBOX_API_TOKEN_PEPPER
#   python3 -c "import secrets; print(secrets.token_hex(6))"    → NETBOX_TOKEN_KEY (12 caractères)
#   python3 -c "import secrets; print(secrets.token_hex(20))"   → NETBOX_TOKEN (40 caractères)
# ─────────────────────────────────────────────────────────────

# Arkime (full packet capture) — secret de chiffrement des mots de passe utilisateurs
ARKIME_PASSWORD_SECRET=
# Espace disque à garder libre pour les PCAP (pourcentage ou Go) — Arkime supprime les plus anciens
ARKIME_FREE_SPACE_G=10%

# NetBox (inventaire / IPAM)
NETBOX_DB_PASSWORD=changeme_remplacer
NETBOX_REDIS_PASSWORD=changeme_remplacer
NETBOX_SECRET_KEY=
# Pepper HMAC des tokens API v2 (NetBox ≥ 4.6, 50 caractères min) — ne jamais le changer après création des tokens
NETBOX_API_TOKEN_PEPPER=
NETBOX_SUPERUSER_NAME=admin
NETBOX_SUPERUSER_EMAIL=admin@netwatch.local
NETBOX_SUPERUSER_PASSWORD=changeme_remplacer
# Token API v2 créé pour le superuser au premier démarrage (NetBox ≥ 4.6 : identifiant
# public 12 caractères + secret 40 caractères). Le portail s'en sert pour enrichir les IP
# et importer les préfixes. Header envoyé : Authorization: Bearer nbt_<KEY>.<TOKEN>
NETBOX_TOKEN_KEY=
NETBOX_TOKEN=

# Kibana — clé de chiffrement des objets sauvegardés (32 caractères min, optionnel)
KIBANA_ENCRYPTION_KEY=

# URLs vues depuis le portail (défauts = stack locale ; vider pour désactiver un service)
NETWATCH_BLACKBOX_URL=http://localhost:9115
NETWATCH_KIBANA_URL=http://localhost:5601
NETWATCH_NTOPNG_URL=http://localhost:3001
NETWATCH_ARKIME_URL=http://localhost:8005
NETWATCH_NETBOX_URL=http://localhost:8000

# Assistant IA local (Ollama) — explication des alertes IDS dans le portail web
# Premier lancement après "docker compose up -d" :
#   docker exec netwatch-ollama ollama pull mistral
OLLAMA_MODEL=mistral

# ITSM Backend (servicenow | jira | none)
ITSM_BACKEND=none
# ServiceNow
SNOW_INSTANCE=mycompany
SNOW_USER=admin
SNOW_PASSWORD=changeme
# JIRA
JIRA_URL=https://mycompany.atlassian.net
JIRA_USER=user@company.com
JIRA_TOKEN=changeme
JIRA_PROJECT_KEY=NOC
